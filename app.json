{
  "expo": {
    "name": "BUFF",
    "slug": "buff-mobile",
    "scheme": "buff",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/BUFF_LOGO.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/BUFF_LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1636"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buff.mobile"
    },
    "android": {
      "package": "com.buffapp.mobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1a1636"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "BUFF uses your photo library for profile pictures."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/BUFF_LOGO.png",
          "color": "#8b5cf6",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "buffadhd",
          "project": "react-native"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/BUFF_LOGO.png",
      "color": "#8b5cf6",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "8796128b-5e2d-4c0e-9c41-016e87c62ab7"
      }
    }
  }
}
