{
  "expo": {
    "name": "BUFF",
    "slug": "buff-mobile",
    "scheme": "buff",
    "version": "1.8.3",
    "orientation": "portrait",
    "icon": "./assets/BUFF_LOGO.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "url": "https://u.expo.dev/8796128b-5e2d-4c0e-9c41-016e87c62ab7",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "splash": {
      "image": "./assets/BUFF_LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1636"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buff.mobile",
      "icon": "./assets/BUFF_LOGO-IOS.png",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.buffapp.mobile",
      "versionCode": 56,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#1a1636"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "buffadhd.com",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BUFF uses your photo library to import images, such as a photo of your child's timetable."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/BUFF_LOGO.png",
          "color": "#8b5cf6",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "buffadhd",
          "project": "react-native",
          "experimental_android": {
            "enableAndroidGradlePlugin": true,
            "autoUploadProguardMapping": true
          }
        }
      ]
    ],
    "notification": {
      "icon": "./assets/BUFF_LOGO.png",
      "color": "#8b5cf6",
      "androidMode": "default"
    },
    "extra": {
      "eas": {
        "projectId": "8796128b-5e2d-4c0e-9c41-016e87c62ab7"
      },
      "vapidPublicKey": "BKu7_rNEcpXoi94OA1rGQmz3AY8ab1vsjHOhUwlZs-kdaddkRB4TladLo-VpVSs5wqskoQbw1S9-1cQR6mPt4YA"
    }
  }
}
