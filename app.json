{
  "expo": {
    "name": "buff-mobile",
    "slug": "buff-mobile",
    "scheme": "buff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/BUFF_LOGO.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/BUFF_LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1636"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buff.mobile"
    },
    "android": {
      "package": "com.buffapp.mobile",
      "versionCode": 1,
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/BUFF_LOGO.png",
        "backgroundColor": "#1a1636"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-localization",
      "@react-native-community/datetimepicker",
      ["expo-image-picker", { "photosPermission": "BUFF uses your photo library for profile pictures." }]
    ],
    "extra": {
      "eas": {
        "projectId": "8796128b-5e2d-4c0e-9c41-016e87c62ab7"
      }
    }
  }
}
