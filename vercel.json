{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/download", "destination": "/download.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
